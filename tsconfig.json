{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "strict": true,
  "compilerOptions": {
    "resolveJsonModule": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": "src",
    "paths": {
      "@screens/*": [
        "screens/*"
      ],
      "@screens": [
        "screens/index"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@assets": [
        "assets/index"
      ],
      "@svg/*": [
        "assets/svg/*"
      ],
      "@svg": [
        "assets/svg/index"
      ],
      "@navigation/*": [
        "navigation/*"
      ],
      "@api/*": [
        "api/*"
      ],
      "@api": [
        "api/index"
      ],
      "@types/*": [
        "types/*"
      ],
      "@types": [
        "types/index"
      ],
      "@components/*": [
        "components/*"
      ],
      "@constants/*": [
        "constants/*"
      ],
      "@constants": [
        "constants/index"
      ],
      "@components": [
        "components/index"
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@utils": [
        "utils/index"
      ],
      "@store/*": [
        "store/*"
      ],
      "@store": [
        "store/index"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@lib": [
        "lib/index"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "global.css",
    "nativewind-env.d.ts"
  ]
}
